# Salin file ini menjadi .env.production untuk mengatur variabel lingkungan saat build produksi (npm run build)
# Ganti URL di bawah ini dengan alamat URL API server backend Anda yang sesungguhnya.

# Contoh jika backend berjalan di port 5000 pada domain yang sama:
VITE_API_URL=https://qurbanku.widiailham.my.id:5000

# Contoh jika menggunakan domain server produksi IP VPS:
# VITE_API_URL=http://192.168.1.100:5000

# Jika Anda mengonfigurasi Nginx/Apache untuk memproyeksikan path "/api" ke backend secara otomatis (rekomendasi),
# biarkan variabel ini kosong atau dikomentari.
# VITE_API_URL=
